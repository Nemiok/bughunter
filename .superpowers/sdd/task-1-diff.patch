   tools: [\n53\t          {\n54\t            name: 'get_cwd',\n55\t            description: 'Return the current working directory of the stdio MCP server process.',\n56\t            inputSchema: { type: 'object', properties: {}, required: [] }\n57\t          }\n58\t        ]\n59\t      });\n60\t    } else if (method === 'tools/call') {\n61\t      const name = params?.name;\n62\t      if (name === 'get_cwd') {\n63\t        send(id, {\n64\t          content: [{ type: 'text', text: JSON.stringify({ cwd: process.cwd() }) }],\n65\t          isError: false\n66\t        });\n67\t      } else {\n68\t        sendError(id, -32601, `Unknown tool: ${name}`);\n69\t      }\n70\t    } else if (id !== undefined) {\n71\t      sendError(id, -32601, `Method not found: ${method}`);\n72\t    }\n73\t  }\n74\t});"}
