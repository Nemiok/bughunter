+function configTemplate(baseUrl: string): Config {
+  return {
+    baseUrl,
+    allowedOrigins: [demoOrigin, controlsOrigin].filter((origin, index, origins) => origins.indexOf(origin) === index),
+    routes: ['/', '/profile', '/orders', '/orders/new', '/clean', '/controls', '/other'],
